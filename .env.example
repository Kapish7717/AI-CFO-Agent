# =============================================================================
# AI CFO Agent — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Application ------------------------------------------------------------
# development | production  (production forces DATABASE_URL + JWT_SECRET_KEY)
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Database ---------------------------------------------------------------
# Postgres/Supabase. Required in every environment.
# `transaction` pooler (port 6543) recommended for serverless/async workloads.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
# Session-mode pooler URL, used only by dbmate migrations. Same credentials and
# host as DATABASE_URL, but port 5432: the transaction pooler on 6543 breaks the
# prepared statements migrations need.
DATABASE_URL_MIGRATIONS=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:5432/postgres
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10

# --- Auth (JWT) --------------------------------------------------------------
# REQUIRED in production. Use a long random string: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: seed the demo user arjun@cfo.com/password123 (dev only)
SEED_DEFAULT_USER=0

# --- CORS -------------------------------------------------------------------
# Comma-separated list of client origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:7860

# --- LLM providers -----------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
JINA_API_KEY=
ALLOW_MODEL_FALLBACK=false

# --- Supabase (object storage) ------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# --- Stripe ------------------------------------------------------------------
# The webhook is only registered when BOTH keys are present, and payloads are
# only accepted with a valid signature.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Reconciliation poll period in seconds. The webhook is the fast path; this poll
# only recovers deliveries it missed. Unset or invalid falls back to 900.
STRIPE_POLL_INTERVAL_SECONDS=900
# The webhook only enqueues into the stripe_events outbox; a drain loop does the
# writing. How often to drain (seconds; default 5) and how many events to take
# per pass (default 50).
STRIPE_OUTBOX_INTERVAL_SECONDS=5
STRIPE_OUTBOX_BATCH=50
# An event is retried this many times before it is parked as 'failed'
# (default 5), and a row left 'processing' longer than this many seconds is
# assumed stranded by a dead worker and requeued (default 600).
STRIPE_OUTBOX_MAX_ATTEMPTS=5
STRIPE_OUTBOX_STALE_SECONDS=600

# --- Google (Gmail/Calendar/Sheets OAuth) -------------------------------------
GOOGLE_CREDENTIALS_JSON=

# --- QuickBooks Online (read-only) -------------------------------------------
# sandbox | production. The fixture generator (scripts/fetch_quickbooks_fixtures.py)
# accepts EITHER a short-lived Playground QBO_ACCESS_TOKEN, OR QBO_REFRESH_TOKEN
# (with the client id/secret), which is exchanged for a fresh access token on
# every run; the rotated refresh token is written back here automatically.
QBO_ENV=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# QBO_REDIRECT_URI must match the Intuit app registration byte-for-byte, e.g.
#   https://<backend-host>/api/integrations/quickbooks/callback
# Webhook signature verifier (from the Intuit app); the callback redirects the
# browser here when set. Generate the secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# TOKEN_ENCRYPTION_KEY may be any long random string -- it is hashed to the
# Fernet key used to encrypt stored OAuth tokens at rest.
QBO_WEBHOOK_VERIFIER=
STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
# ALLOWED_UPLOAD_EXTENSIONS defaults to .csv,.xlsx,.xls

# --- Dashboard -----------------------------------------------------------------
# Seed "cash on hand" folded into the dashboard cash-balance calculation.
CASH_BASE_AMOUNT=1750000

# --- Cache (Upstash Redis) ------------------------------------------------------
# Response cache for /api/dashboard/overview (app/core/cache.py). Create a DB at
# console.upstash.com in a region close to the API host (Render is in Oregon ->
# us-west-2) and paste the values from the "Tokens" tab. When BOTH are empty the
# app runs fine with caching disabled (every request recomputes).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# How long a cached dashboard stays fresh, in seconds.
DASHBOARD_CACHE_TTL_SECONDS=30

# --- Frontend (Vercel) ----------------------------------------------------------
# Not read by the backend: set this in Vercel's project environment variables to
# the Render URL (e.g. https://ai-cfo-agent.onrender.com) so browser API calls
# reach the API instead of being rewritten to index.html.
# VITE_API_BASE_URL=